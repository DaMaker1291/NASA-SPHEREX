{
  "name": "creative-agency",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/postbuild.mjs",
    "start": "node server.mjs",
    "preview": "vite preview",
    "stress": "node scripts/stress.mjs",
    "test": "node --experimental-strip-types --test tests/spherex-math.test.mjs tests/spherex-mirror.test.mjs",
    "mirror:default": "node scripts/mirror-spherex.mjs",
    "mirror:verify": "node scripts/mirror-spherex.mjs --verify",
    "index:s3": "node scripts/build-s3-index.mjs",
    "index:s3:full": "node scripts/build-s3-index-full.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "astronomy-engine": "^2.1.19",
    "hono": "^4.13.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
